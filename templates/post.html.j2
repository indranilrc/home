{% extends "base.html.j2" %}
{% block title %}{{ post.title }} · {{ site.title }}{% endblock %}
{% block description %}{{ post.summary }}{% endblock %}
{% block head_extra %}
<meta property="og:type" content="article">
<meta property="article:published_time" content="{{ post.date.isoformat() }}">
<link rel="alternate" type="application/atom+xml" title="Writing" href="{{ '/writing/feed.xml' | url }}">
{% endblock %}
{% block content %}
<article class="wrap">
  <div class="article">
    <header>
      <h1>{{ post.title }}</h1>
      <time datetime="{{ post.date.isoformat() }}">{{ post.date.strftime('%B') }} {{ post.date.day }}, {{ post.date.year }}</time>
    </header>
    <div class="prose">{{ post.html }}</div>
    <p class="more"><a href="{{ '/writing/' | url }}">More writing</a></p>
  </div>
</article>
{% endblock %}
