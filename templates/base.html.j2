<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
(function(){try{var t=localStorage.getItem("theme");if(t==="dark"||t==="light"){document.documentElement.dataset.theme=t;}}catch(e){}})();
</script>
{% set canonical = site.url ~ base ~ page_path %}
<title>{% block title %}{{ site.title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ profile.description | default('') }}{% endblock %}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.url ~ base }}/img/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{% if page_id != 'writing' or not post %}<meta property="og:type" content="{{ 'profile' if page_id == 'home' else 'website' }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ '/img/favicon.svg' | url }}" type="image/svg+xml">
<link rel="preload" href="{{ '/fonts/ibm-plex-sans-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/css/site.css' | url }}">
{% block head_extra %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="site-name" href="{{ '/' | url }}"{% if page_id == 'home' %} aria-current="page"{% endif %}>{{ site.title }}</a>
    <nav class="site-nav" aria-label="Main">
      {% for label, path, pid in nav %}
      <a href="{{ path | url }}"{% if page_id == pid %} aria-current="page"{% endif %}>{{ label }}</a>
      {% endfor %}
      <button class="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch to light mode" hidden>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>
<main id="main">
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    <span>&copy; {{ build_date.year }} {{ site.title }} &middot; Last updated {{ build_date.strftime('%B') }} {{ build_date.day }}, {{ build_date.year }}</span>
    <nav aria-label="Elsewhere">
      {% for link in profile.links | default([]) %}<a href="{{ link.url }}" rel="me noopener">{{ link.label }}</a>{% endfor %}
    </nav>
  </div>
</footer>
<script src="{{ '/js/theme.js' | url }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
